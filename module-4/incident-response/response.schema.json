{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zctaskflow.athing.cc/schemas/m4/response.schema.json",
  "title": "TaskFlow M4 Incident Responder Response",
  "description": "Structured, evidence-bound response from the headless TaskFlow incident responder. The responder proposes an action; it does not authorize or execute the action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "evidence_summary",
    "likely_cause",
    "confidence",
    "proposed_action",
    "escalation",
    "rationale",
    "missing_evidence",
    "responder"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Stable identifier linking the response to the incident record."
    },
    "evidence_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "Concise summary of bounded evidence actually reviewed."
    },
    "likely_cause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Evidence-based likely or contributing cause."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "uncertainty"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "proposed_action": {
      "description": "Optional bounded action proposal. This field carries an allowlisted action identifier only; it must never contain commands or executable model text.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "enum": [
                "recover_task_list_dev_fault"
              ]
            }
          }
        }
      ]
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "none",
            "escalate"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "escalate"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Reasoning that links the assessment to the bounded evidence."
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "Evidence gaps that materially limit the assessment."
    },
    "responder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "provider",
        "adapter",
        "configuration_ref"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "Provenance needed to reconstruct the responder configuration. Do not place secrets or credentials in these fields."
    }
  }
}
